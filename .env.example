# =============================================================================
# DDEX Delivery & Ingestion Tool — environment configuration
# =============================================================================
#
# Setup:
#   1. Copy this file:      cp .env.example .env
#   2. Fill in your real values below.
#   3. Never commit .env — it's already listed in .gitignore.
#
# These variables are used by INGEST mode only (the server you download
# deliveries FROM). DELIVER mode prompts for its own connection details
# each time you run it, since you're often delivering to a different
# server than the one you ingest from.
# =============================================================================

# Hostname or IP address of the SFTP server to connect to.
SFTP_HOST=your.sftp.server.com

# Port the SFTP server listens on. 22 is the standard default — only
# change this if your server explicitly uses something else.
SFTP_PORT=22

# Login credentials for that server.
SFTP_USERNAME=your_username
SFTP_PASSWORD=your_password

# The directory on the remote server where incoming deliveries live,
# e.g. /home/deliveries or /uploads
REMOTE_UPLOAD_DIR=/path/on/server/to/incoming/deliveries
